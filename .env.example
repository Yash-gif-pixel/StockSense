# Copy to backend/.env (the backend reads .env from its own working directory).

# development | test | production
ENV=development

# Used for JWT signing (HS256) and OTP HMAC. Must be changed when ENV=production.
SECRET_KEY=dev-insecure-secret-change-me-before-production

# Dev database (docker-compose service "db")
DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5432/stocksense
# Test database (docker-compose service "db-test"); pytest wipes and re-migrates it.
TEST_DATABASE_URL=postgresql+psycopg://stocksense:stocksense@localhost:5433/stocksense_test

# Timezone used to decide what "today" means for late/upcoming
APP_TIMEZONE=Asia/Kolkata

# Auth cookie lifetime
TOKEN_TTL_HOURS=8

# Password-reset OTP policy
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Comma-separated list of browser origins allowed to send credentialed requests
CORS_ORIGINS=http://localhost:5173

# SMTP is optional. Leave SMTP_HOST empty in development and the OTP is logged
# to the console instead of being emailed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@stocksense.example
SMTP_TLS=true
